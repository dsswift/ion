{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "tag-separator": "-",
  "types": [
    "feat!",
    "feat",
    "fix",
    "chore",
    "docs"
  ],
  "scopes": [
    "repo",
    "docs",
    "ci",
    "deps"
  ],
  "subject-max-length": 65,
  "packages": {
    "engine": {
      "component": "engine",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    },
    "desktop": {
      "component": "desktop",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    },
    "relay": {
      "component": "relay",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    },
    "ios": {
      "component": "ios",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    },
    "sdk/go": {
      "component": "sdk/go",
      "commit-scope": "sdk",
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    },
    "server": {
      "component": "server",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ]
    }
  }
}
