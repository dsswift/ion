    {
      "id": 16,
      "type": "stat",
      "title": "Autonomy ratio (Trust)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "description": "Fraction of permission checks that resolved to allow over the range, from the permission.decision event. Red below 0.5, green from 0.8: a low ratio is a rule set that keeps asking. See Ion Trust for the decisions behind it.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "mappings": [],
          "links": [
            {
              "title": "Ion Trust",
              "url": "/d/ion-trust",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({event_name=\"permission.decision\", host_name=~\"$host\", user=~\"$user\"} | json | payload_decision=\"allow\" [$__range])) / sum(count_over_time({event_name=\"permission.decision\", host_name=~\"$host\", user=~\"$user\"} | json [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
