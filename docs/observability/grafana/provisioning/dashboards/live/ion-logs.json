    {
      "id": 14,
      "type": "timeseries",
      "title": "TTFT last hour (p50 sparkline)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "description": "Streaming time to first token, p50 per step, from provider.ttft (payload.ttft_ms). A rising trend mid-session means providers are responding slower.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "maxDataPoints": 2000,
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.5, {event_name=\"provider.ttft\", host_name=~\"$host\", user=~\"$user\"} | json | unwrap payload_ttft_ms [$__interval]) by ()",
          "queryType": "range",
          "refId": "A",
          "__ionClass": "windowed-stat",
          "legendFormat": "TTFT p50"
        }
      ]
    },
