            "uid": "loki"
          },
          "expr": "sum(count_over_time({event_name=\"dispatch.agent\", host_name=~\"$host\", user=~\"$user\"} | json [5m]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
