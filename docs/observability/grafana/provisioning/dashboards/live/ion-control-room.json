  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "ion",
    "live"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Device",
        "type": "query",
        "description": "The device a line came from (label `host_name`, the OTLP host.name). Multi-select; All includes lines with no device.",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(host_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      },
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "description": "The signed-in operator (Alloy label `user`). Multi-select; All includes lines with no identity.",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(user)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Ion Control Room",
  "uid": "ion-control-room",
  "version": 1
