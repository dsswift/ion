{
  "annotations": {
    "list": []
  },
  "description": "Ion fleet — who is running Ion, where, and on what version?",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Hosts reporting",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "mappings": [],
          "noValue": "telemetry off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (host_name) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Installs",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "description": "Distinct service_instance_id values — engine installations, which can outnumber hosts when headless instances share a machine.",
