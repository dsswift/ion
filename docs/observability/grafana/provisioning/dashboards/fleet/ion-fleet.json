        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "mappings": [],
          "noValue": "telemetry off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (service_instance_id) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Engine versions in fleet",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "description": "Distinct engine version strings reporting in the window. More than one is version drift — see the drift table below for who is behind.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (service_version) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fleet spend",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "mappings": [],
          "links": [
            {
              "title": "Ion Cost",
              "url": "/d/ion-cost"
            }
          ],
          "noValue": "telemetry off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({event_name=\"run.complete\", host_name=~\"$host\", user=~\"$user\"} | json | unwrap payload_run_cost_usd [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fleet errors",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "description": "Telemetry events carrying a non-empty payload_error. Operational ERROR lines per device are on Errors & Health, scoped with the Device filter.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json | payload_error!=\"\" [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Host last-seen (min)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "description": "Minutes since the most recent telemetry event per host. Fixed 24h lookback (liveness detector): a host whose engine stopped reporting climbs while the others stay near zero.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(vector(${__to:date:seconds}) - on() group_right() max by (host_name) (max_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json | label_format ts_unix=\"{{ __timestamp__ | unixEpoch }}\" | unwrap ts_unix [24h]))) / 60",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "instant",
          "legendFormat": "{{host_name}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Installations and versions",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Installs per host",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "description": "Distinct service_instance_id count per host. More than one means several engine instances (e.g. headless daemons) share the machine.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count by (host_name) (sum by (host_name, service_instance_id) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation",
          "legendFormat": "{{host_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Version drift",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 5
      },
      "description": "Every host / install / engine-version combination reporting in the window, with its event count. Two rows for one install means it upgraded mid-window.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Events",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "host_name": "Host",
              "service_instance_id": "Install",
              "service_version": "Engine version",
              "Value": "Events"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host_name, service_instance_id, service_version) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation",
          "legendFormat": "{{host_name}} / {{service_instance_id}} / {{service_version}}"
        }
      ]
    },
