    {
      "id": 6,
      "type": "stat",
      "title": "Device last-seen (min)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "description": "Minutes since the most recent iOS log line per device. Fixed 24h lookback (liveness detector): a device whose logs stopped arriving climbs while the others stay near zero.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(vector(${__to:date:seconds}) - on() group_right() max by (device_id, device_model) (max_over_time({service_name=\"ion-ios\", event_name=\"\", host_name=~\"$host\", user=~\"$user\"} | json device_id=\"fields.device_id\", device_model=\"fields.device_model\", pairing_id=\"fields.pairing_id\", desktop_host=\"fields.desktop_host\", app_version=\"fields.app_version\", app_build=\"fields.app_build\", os_version=\"fields.os_version\", mdm_device_id=\"fields.mdm_device_id\", mdm_serial=\"fields.mdm_serial\" | __error__=\"\" | device_model=~\"$device\" | label_format ts_unix=\"{{ __timestamp__ | unixEpoch }}\" | unwrap ts_unix [24h]))) / 60",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "instant",
          "legendFormat": "{{device_model}} {{device_id}}"
        }
      ]
    },
