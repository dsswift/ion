  "description": "Ion users — who is using Ion and what is their footprint?",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "Active users",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "description": "Distinct signed-in users seen in telemetry over the dashboard time range. Lines with no user (installs with no identity, machine-level metrics) are not counted here; they appear as \"unassigned\" in the panels below.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": []
          },
          "mappings": [],
          "noValue": "telemetry off"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count(sum by (user) (count_over_time({event_name=~\".+\", host_name=~\"$host\", user=~\"$user\"} | json | label_format user=`{{if .user}}{{.user}}{{else}}unassigned{{end}}` | user=~\"$user\" | service_instance_id=~\"$install\" | user!=\"unassigned\" [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "accumulation"
        }
      ]
    },
