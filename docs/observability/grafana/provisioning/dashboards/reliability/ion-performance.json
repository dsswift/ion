{
  "annotations": {
    "list": []
  },
  "description": "How long each operation takes, end to end, from the spans the engine emits: percentiles per span name and service from Tempo's span metrics in Prometheus, run duration beside cost, cold starts, command dispatch and conversation persistence, and the engine GC and scheduler from the System Metrics sample lines.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latency by span",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Engine spans p95",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "description": "p95 of every engine span per step, one line per span name: run.execute, llm.call, llm.attempt, tool.execute, extension.hook_latency, hook.fanout, dispatch.agent, command.dispatch, conversation.load, conversation.persist, context.assemble, compaction, mcp.start, mcp.call, extension.spawn, permission.decide, config.load, provider.probe, session.start, daemon.startup. Backend and Model filter the spans that carry those attributes. Source: traces_spanmetrics_latency_bucket{service=\"ion-engine\"}.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "maxDataPoints": 2000,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_name=~\".+\", service=\"ion-engine\", backend=~\"$backend\", model=~\"$model\", host_name=~\"$host\", user=~\"$user\"}[$__rate_interval])))",
          "queryType": "range",
          "refId": "A",
          "__ionClass": "windowed-stat",
          "instant": false,
          "range": true,
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "p50 / p95 / p99 per span and service",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "description": "Every span name Tempo has seen in the range, by service, with its p50, p95, and p99 over the whole range. Sort by p99 to find the slowest operation. Seconds. Source: traces_spanmetrics_latency_bucket.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "span_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "span"
              },
              {
                "id": "custom.width",
                "value": 240
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p95"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p99"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "p99",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{span_name=~\".+\", host_name=~\"$host\", user=~\"$user\"}[$__range])))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{span_name=~\".+\", host_name=~\"$host\", user=~\"$user\"}[$__range])))",
          "queryType": "instant",
          "refId": "B",
          "__ionClass": "instant",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{span_name=~\".+\", host_name=~\"$host\", user=~\"$user\"}[$__range])))",
          "queryType": "instant",
          "refId": "C",
          "__ionClass": "instant",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Run duration and cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "run.execute p50 / p95 by model",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "description": "How long an engine run takes from start to exit, per model, from the run.execute span. The alert \"Ion run p95 over 120 s\" reads the ungrouped p95. Source: traces_spanmetrics_latency_bucket{span_name=\"run.execute\"}.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "maxDataPoints": 2000,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(traces_spanmetrics_latency_bucket{span_name=\"run.execute\", service=\"ion-engine\", backend=~\"$backend\", model=~\"$model\", host_name=~\"$host\", user=~\"$user\"}[$__rate_interval])))",
          "queryType": "range",
          "refId": "A",
          "__ionClass": "windowed-stat",
          "instant": false,
          "range": true,
          "legendFormat": "p50 {{model}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(traces_spanmetrics_latency_bucket{span_name=\"run.execute\", service=\"ion-engine\", backend=~\"$backend\", model=~\"$model\", host_name=~\"$host\", user=~\"$user\"}[$__rate_interval])))",
          "queryType": "range",
          "refId": "B",
          "__ionClass": "windowed-stat",
          "instant": false,
          "range": true,
          "legendFormat": "p95 {{model}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM call, attempt, and tool p95",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "description": "Inside a run: llm.call is one model turn including retries, llm.attempt one request to the provider, tool.execute one tool call, provider.probe one provider reachability probe. A gap between llm.call and llm.attempt is retry time. Source: traces_spanmetrics_latency_bucket{service=\"ion-engine\"}.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "maxDataPoints": 2000,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{span_name=~\"llm.call|llm.attempt|tool.execute|provider.probe\", service=\"ion-engine\", backend=~\"$backend\", model=~\"$model\", host_name=~\"$host\", user=~\"$user\"}[$__rate_interval])))",
          "queryType": "range",
          "refId": "A",
          "__ionClass": "windowed-stat",
          "instant": false,
          "range": true,
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "Cost and duration per run, by model",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "description": "One row per model over the range: runs, average cost per run (run_cost_usd, this run only, excluding dispatched sub-agents), and the p95 run duration the engine reported on run.complete. Reads the telemetry event, so it needs telemetry enabled; the span panel beside it reads the same runs as spans. Source: {event_name=\"run.complete\"}.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "payload_model"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "model"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "runs"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "cost / run"
              },
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "duration p95"
              },
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "cost / run",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (payload_model) (count_over_time({event_name=\"run.complete\", host_name=~\"$host\", user=~\"$user\"} | json [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "__ionClass": "instant"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (payload_model) (sum_over_time({event_name=\"run.complete\", host_name=~\"$host\", user=~\"$user\"} | json | unwrap payload_run_cost_usd [$__range])) / sum by (payload_model) (count_over_time({event_name=\"run.complete\", host_name=~\"$host\", user=~\"$user\"} | json [$__range]))",
          "queryType": "instant",
          "refId": "B",
          "__ionClass": "windowed-stat"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {event_name=\"run.complete\", host_name=~\"$host\", user=~\"$user\"} | json | unwrap payload_duration_ms [$__range]) by (payload_model)",
          "queryType": "instant",
          "refId": "C",
          "__ionClass": "windowed-stat"
        }
      ]
    },
