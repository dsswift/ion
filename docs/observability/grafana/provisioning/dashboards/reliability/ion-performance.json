    {
      "id": 33,
      "type": "timeseries",
      "title": "Engine GC pause p99 and scheduler latency p99",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "description": "The Go runtime's stop-the-world pause and goroutine scheduling latency inside the engine, per device: the p99 within each 30 s sample, averaged over 5 m. Source: engine.jsonl tag=sysmetrics fields.gc_pause_p99_ms / sched_latency_p99_ms.",
