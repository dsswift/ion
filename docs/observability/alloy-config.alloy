// Ion observability — Grafana Alloy River config.
//
// Every record lands in Loki under the names its OTLP form carries (Ion
// telemetry schema v2, docs/observability/log-schema.md § "Names in Loki"):
// the service that wrote it is the `service_name` label (OTLP service.name,
// ion-<component>), a telemetry event's name is the `event_name` label (OTLP
// event.name), the device is the `host_name` label (OTLP host.name), and the
// trace and span are the `trace_id` and `span_id` structured metadata (the
// OTLP LogRecord traceId and spanId). An operational line has no event_name.
//
// Two pipelines:
//   1. ion_parse     — tails engine.jsonl, server.jsonl, desktop.jsonl and
//                      ios-diagnostic-logs.jsonl, and promotes
//                      service_name/level/tag as Loki stream labels.
//   2. ion_telemetry — receives expanded telemetry events from the
//                      telemetry-forwarder and promotes the event name as the
//                      low-cardinality event_name label; all
//                      numeric/high-cardinality fields go into structured_metadata.
//                      Also extracts the standalone conversation.* family
//                      (conv_* keys below) when an operator points
//                      conversationEvents's httpEndpoint at this same
//                      telemetry-forwarder — a separate Collector/config from
//                      telemetry.*, sharing this pipeline only by destination
//                      choice, not by contract.
//
// Label cardinality discipline (see Loki docs):
//   stage.labels           — only low-cardinality, enumerable values (service_name, level, tag, event_name, host_name, user)
//   stage.structured_metadata — high-cardinality or numeric (model, cost_usd, duration_ms, etc.)
//   Mixing these causes Loki cardinality explosions.
//
// Mount: docker-compose.yml binds ${HOME}/.ion to /ion-logs:ro inside the container.
// Alloy does NOT expand ~; all paths use the /ion-logs mount point.
//
// Telemetry self-healing: local.file_match is silent when the target file does not
// exist (no error, zero targets). The telemetry pipeline activates automatically
// once telemetry.jsonl appears (after enabling telemetry in engine.json and
// restarting Alloy). See README.md for the one-line engine.json snippet.

// ---------------------------------------------------------------------------
// 1. STRUCTURED LOG PIPELINE — engine / server / desktop / ios logs
//
// Explicit file list (not a glob) to prevent telemetry.jsonl from being
// ingested by this pipeline. If a glob were used, telemetry.jsonl would be
// parsed as a structured log line and the JSON fields would be misrouted.
// ---------------------------------------------------------------------------

local.file_match "ion_logs" {
  path_targets = [
    {"__path__" = "/ion-logs/engine.jsonl"},
    // The Ion Studio Server's own lines (component=server) and the browser
    // client lines it records for them (component=web). Absent until the
    // server split made them their own file, which is how they went
    // uncollected.
    {"__path__" = "/ion-logs/server.jsonl"},
    {"__path__" = "/ion-logs/desktop.jsonl"},
    {"__path__" = "/ion-logs/ios-diagnostic-logs.jsonl"},
  ]
  sync_period = "5s"
}

loki.source.file "ion_jsonl" {
  targets    = local.file_match.ion_logs.targets
  forward_to = [loki.process.ion_parse.receiver]
}

loki.process "ion_parse" {
  stage.json {
    expressions = {
      component       = "component",
      level           = "level",
      tag             = "tag",
      trace_id        = "trace_id",
      line_span_id    = "span_id",
      fields_span_id  = "fields.span_id",
      ios_device_id   = "fields.device_id",
      ios_app_version = "fields.app_version",
    }
  }

  // service_name is the OTLP service.name: ion-<component>.
  stage.template {
    source   = "service_name"
    template = "{{ if .component }}ion-{{ .component }}{{ end }}"
  }

  // span_id is the span the line is about: a span line's own fields.span_id,
  // else the span the line was logged under.
  stage.template {
    source   = "span_id"
    template = "{{ if .fields_span_id }}{{ .fields_span_id }}{{ else if .line_span_id }}{{ .line_span_id }}{{ end }}"
  }

  // An iOS line describes the device that wrote it: its instance and build
  // are the device's (OTLP service.instance.id, service.version).
  stage.template {
    source   = "service_instance_id"
    template = "{{ if and .component (eq .component \"ios\") .ios_device_id }}{{ .ios_device_id }}{{ end }}"
  }

  stage.template {
    source   = "service_version"
    template = "{{ if and .component (eq .component \"ios\") .ios_app_version }}{{ .ios_app_version }}{{ end }}"
  }

  // Promote only the low-cardinality fields to stream labels. The ids stay
  // off the index as structured metadata, filtered with `| trace_id = "..."`
  // (no json parse); session_id and conversation_id stay in the body.
  stage.labels {
    values = {
      service_name = "service_name",
      level        = "level",
      tag          = "tag",
    }
  }

  stage.structured_metadata {
    values = {
      trace_id            = "trace_id",
      span_id             = "span_id",
      service_instance_id = "service_instance_id",
      service_version     = "service_version",
    }
  }

  forward_to = [loki.process.ion_identity.receiver]
}

// ---------------------------------------------------------------------------
// 2. TELEMETRY PIPELINE — compact-frame forwarder → Loki Push API
//
// The engine writes schema-v4 compact frames. The telemetry-forwarder expands
// file records, at any schema at or below its own, into one standard telemetry
// event per Loki Push entry.
// Alloy receives those entries through its Loki API endpoint. It must not tail
// telemetry.jsonl directly: a frame can contain more than one event.
//
// The forwarder labels each stream service_name=ion-<component>, the
// service that recorded the event. This processor adds the event_name label
// and the structured metadata below; the event's install and build become
// service_instance_id and service_version, its trace trace_id, and the span
// it is about span_id, as its OTLP form carries them.
// ---------------------------------------------------------------------------

loki.source.api "telemetry" {
  use_incoming_timestamp = true
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3500
  }
  forward_to = [loki.process.ion_telemetry.receiver]
}

loki.process "ion_telemetry" {
  stage.json {
    expressions = {
      "ts"                        = "ts",
      "event_name"                = "name",
      "model"                     = "payload.model",
      "tool"                      = "payload.tool",
      "stop_reason"               = "payload.stop_reason",
      "duration_ms"               = "payload.duration_ms",
      "run_cost_usd"              = "payload.run_cost_usd",
      "agg_cost_usd"              = "payload.aggregate_cost_usd",
      "dispatch_depth"            = "payload.dispatch_depth",
      "num_turns"                 = "payload.num_turns",
      "input_tokens"              = "payload.input_tokens",
      "output_tokens"             = "payload.output_tokens",
      "cache_read_tokens"         = "payload.cache_read_input_tokens",
      "cache_creation_tokens"     = "payload.cache_creation_input_tokens",
      "error"                     = "payload.error",
      "trace_id"                  = "trace_id",
      "payload_span_id"           = "payload.span_id",
      "context_parent_span_id"    = "context.parent_span_id",
      "schema_version"            = "schema",
      "service_instance_id"       = "install_id",
      "service_version"           = "version",
      "context_conversation_id"   = "context.conversation_id",
      "context_session_id"        = "context.session_id",
      "context_extension"         = "context.extension",
      "context_extension_version" = "context.extension_version",

      // conversation.* family (issue #378) — metadata-only payload keys.
      // Shares this pipeline: an operator who points ConversationEventsConfig's
      // httpEndpoint at the same telemetry-forwarder gets these extracted
      // alongside the general telemetry.* family. conv_ prefix avoids
      // colliding with the general family's own "tool"/"model" keys, since
      // conversation.tool_call's payload key is "tool_name" (not "tool") and
      // its meaning (the tool a turn invoked) differs from llm.call's "tool".
      "conv_conversation_id"      = "payload.conversation_id",
      "conv_entry_id"             = "payload.entry_id",
      "conv_run_id"               = "payload.run_id",
      "conv_dispatch_id"          = "payload.dispatch_id",
      "conv_tool_use_id"          = "payload.tool_use_id",
      "conv_tool_name"            = "payload.tool_name",
      "conv_outcome"              = "payload.outcome",
      "conv_action"               = "payload.action",
      "conv_cost_input_tokens"    = "payload.cost.input_tokens",
      "conv_cost_output_tokens"   = "payload.cost.output_tokens",
      "conv_cost_read_tokens"     = "payload.cost.cache_read_input_tokens",
      "conv_cost_creation_tokens" = "payload.cost.cache_creation_input_tokens",
      "conv_cost_usd"             = "payload.cost.cost_usd",
    }
  }

  // Event time is the telemetry ts field, not the forwarding time.
  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  // span_id is the span the event is about: a span event's own id, else
  // the span it was emitted under.
  stage.template {
    source   = "span_id"
    template = "{{ if .payload_span_id }}{{ .payload_span_id }}{{ else if .context_parent_span_id }}{{ .context_parent_span_id }}{{ end }}"
  }

  stage.labels {
    values = {
      "event_name" = "",
    }
  }

  stage.structured_metadata {
    values = {
      "model"                     = "",
      "tool"                      = "",
      "stop_reason"               = "",
      "duration_ms"               = "",
      "run_cost_usd"              = "",
      "agg_cost_usd"              = "",
      "dispatch_depth"            = "",
      "num_turns"                 = "",
      "input_tokens"              = "",
      "output_tokens"             = "",
      "cache_read_tokens"         = "",
      "cache_creation_tokens"     = "",
      "error"                     = "",
      "trace_id"                  = "",
      "span_id"                   = "",
      "schema_version"            = "",
      "service_instance_id"       = "",
      "service_version"           = "",
      "context_conversation_id"   = "",
      "context_session_id"        = "",
      "context_extension"         = "",
      "context_extension_version" = "",
      "conv_conversation_id"      = "",
      "conv_entry_id"             = "",
      "conv_run_id"               = "",
      "conv_dispatch_id"          = "",
      "conv_tool_use_id"          = "",
      "conv_tool_name"            = "",
      "conv_outcome"              = "",
      "conv_action"               = "",
      "conv_cost_input_tokens"    = "",
      "conv_cost_output_tokens"   = "",
      "conv_cost_read_tokens"     = "",
      "conv_cost_creation_tokens" = "",
      "conv_cost_usd"             = "",
    }
  }

  forward_to = [loki.process.ion_identity.receiver]
}

// ---------------------------------------------------------------------------
// IDENTITY — the device and person every record came from, as stream labels.
//
// Both pipelines above pass through here on their way to Loki, so every line
// carries the same two labels whatever shape it arrived in:
//
//   host_name  the OTLP host.name. Telemetry events carry it top-level
//              (`host`); operational log lines carry it in `fields.host` (every
//              logger stamps it). `.local` is trimmed so one machine has one
//              name, as the OTLP resource does.
//   user       the signed-in operator (`user`, top-level on both shapes),
//              present when the engine or desktop had an identity to report.
//
// A line with neither leaves the label unset; a dashboard's `host_name=~".*"`
// still matches it. These are the only identity labels: machine_id and the
// MDM ids stay in the body because they are one-per-install and would
// multiply streams. Every dashboard filters on them through the global
// $host / $user variables (docs/observability/dashboards/src/dashboard.ts).
// ---------------------------------------------------------------------------

loki.process "ion_identity" {
  stage.json {
    expressions = {
      id_host        = "host",
      id_fields_host = "fields.host",
      user           = "user",
    }
  }

  stage.template {
    source   = "host_name"
    template = "{{ if .id_host }}{{ TrimSuffix .id_host \".local\" }}{{ else if .id_fields_host }}{{ TrimSuffix .id_fields_host \".local\" }}{{ end }}"
  }

  stage.labels {
    values = {
      host_name = "host_name",
      user      = "user",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// ---------------------------------------------------------------------------
// 3. WRITE — ship both pipelines to local Loki.
//
// reject_old_samples = false allows Loki to accept event-time entries older
// than the default 1-hour reject window. Combined with stage.timestamp above,
// events are indexed by their original event time, not ingestion time.
// ---------------------------------------------------------------------------

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
  external_labels = {}
  // Accept event-time entries of any age (out-of-order line recovery, delayed shipping).
}

// ---------------------------------------------------------------------------
// 4. OPENTELEMETRY / TEMPO (optional — comment out if not using trace correlation)
// ---------------------------------------------------------------------------

// A log shipper pointed at this stack (logging.egressOtel.endpoint =
// http://localhost:4318) posts its logs before its spans, and sends the spans
// only once the logs are accepted. This stack already reads every Ion log file
// from disk (section 1), so OTLP logs are accepted and dropped here rather
// than stored twice. Traces go to Tempo.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    logs   = [otelcol.exporter.loki.otlp_logs_already_tailed.input]
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.loki "otlp_logs_already_tailed" {
  forward_to = [loki.process.drop_otlp_logs.receiver]
}

loki.process "drop_otlp_logs" {
  stage.drop {
    expression = ".*"
    drop_counter_reason = "otlp_log_already_tailed_from_file"
  }
  forward_to = []
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
