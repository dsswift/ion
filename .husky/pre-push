#!/usr/bin/env sh
# Delegator only. Husky invokes hooks with `sh -e "$hook"` (.husky/_/h), so the
# shebang above is never consulted and the body runs under dash on Linux —
# where `set -o pipefail` and bash arrays are syntax errors. Keeping this file
# dash-safe and exec'ing bash on the real gate script is what makes the
# pre-push gates actually run on every platform.
#
# Gate logic, comments, and bypass notes: scripts/pre-push.sh
exec bash "$(git rev-parse --show-toplevel)/scripts/pre-push.sh" "$@"
