{
  "telemetry": {
    "enabled": true
  },
  "auth": {
    "oauth": {
      "telemetry-ship": {
        "machineIdentity": {
          "source": "client_secret",
          "clientSecretEnv": "ION_TELEMETRY_SHIP_CLIENT_SECRET"
        }
      }
    }
  },
  "logging": {
    "egressTargets": ["otel"],
    "egressOtel": {
      "enabled": true
    },
    "egressShipSources": ["engine", "telemetry"],
    "egressClientShipSources": [],
    "egressTokenProvider": "telemetry-ship"
  }
}
