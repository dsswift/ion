#!/bin/bash
# preinstall — make it safe for the payload to land, before anything is written.
#
# A running Ion is refused by default, so an install started by hand never
# stops someone's work. Device policy can select the unattended path, which
# stops Ion and carries on (ion-pkg-common.sh).
set -euo pipefail

SCRIPT_NAME="preinstall"
# shellcheck source=desktop/scripts/pkg-scripts/ion-pkg-common.sh
. "$(dirname "$0")/ion-pkg-common.sh"

# An install interrupted between postinstall's two renames leaves the previous
# bundle set aside and nothing in its place. Put it back before deciding
# anything else.
if [ -d "$PREVIOUS_APP" ]; then
  if [ -d "$APP_PATH" ]; then
    rm -rf "$PREVIOUS_APP"
    log "removed the set-aside bundle left by an earlier install."
  else
    mv "$PREVIOUS_APP" "$APP_PATH"
    log "restored the previous bundle left set aside by an interrupted install."
  fi
fi

# Non-zero aborts before the payload is written.
ensure_app_stopped || exit 1

# The payload must land in an empty staging directory: a bundle left by an
# interrupted install would otherwise be merged with the new one.
rm -rf "$STAGING_DIR" "$INCOMING_APP"
log "staging directory is clean; proceeding with install."
