#!/bin/bash
# @file-size-exception: Installer preflight must keep the full safety contract visible
#
# preinstall — refuse to overwrite a live Ion application bundle.
#
# A package script cannot safely wait without a finite system timeout, and it
# cannot provide a reliable custom retry screen in Installer.app. A live Ion
# must therefore leave the bundle untouched. `make desktop` avoids this manual
# retry by using its detached coordinator: it requests the normal Ion drain,
# waits outside Installer without a timeout, then opens this package.
set -euo pipefail

APP_NAME="Ion"
LOG_FILE="/var/log/install.log"

log() { printf '[Ion preinstall] %s\n' "$1" | tee -a "$LOG_FILE"; }

APP_PID="$(pgrep -f "${APP_NAME}.app/Contents/MacOS/${APP_NAME}\$" 2>/dev/null | head -1 || true)"
if [ -z "$APP_PID" ]; then
  log "${APP_NAME} is not running; proceeding with install."
  exit 0
fi

log "${APP_NAME} is running (pid ${APP_PID}); refusing to replace the live application bundle."
log "Quit ${APP_NAME}, then click Install again."

# Non-zero aborts before the payload changes. Installer.app shows its standard
# failure result and the log gives the exact retry instruction.
exit 1
